<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_user_selection">

    <fragment
        android:id="@+id/nav_user_selection"
        android:name="com.example.ecossistemamobileweektech.UserSelectionFragment"
        android:label="Seleção de Acesso"
        tools:layout="@layout/fragment_user_selection" />

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.ecossistemamobileweektech.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_registration"
        android:name="com.example.ecossistemamobileweektech.RegistrationFragment"
        android:label="Inscrição de Aluno"
        tools:layout="@layout/fragment_registration">
        <action
            android:id="@+id/action_registration_to_project"
            app:destination="@id/nav_project_registration" />
    </fragment>

    <fragment
        android:id="@+id/nav_project_registration"
        android:name="com.example.ecossistemamobileweektech.ProjectRegistrationFragment"
        android:label="Cadastro Projeto"
        tools:layout="@layout/fragment_project_registration" />

    <fragment
        android:id="@+id/nav_admin_login"
        android:name="com.example.ecossistemamobileweektech.AdminLoginFragment"
        android:label="Login Admin"
        tools:layout="@layout/fragment_admin_login">
        <action
            android:id="@+id/action_login_to_dashboard"
            app:destination="@id/nav_admin_dashboard" />
    </fragment>

    <fragment
        android:id="@+id/nav_admin_dashboard"
        android:name="com.example.ecossistemamobileweektech.AdminDashboardFragment"
        android:label="Painel Administrativo"
        tools:layout="@layout/fragment_admin_dashboard">
        <action
            android:id="@+id/action_dashboard_to_add_admin"
            app:destination="@id/nav_add_admin" />
        <action
            android:id="@+id/action_dashboard_to_event_details"
            app:destination="@id/nav_event_details" />
    </fragment>

    <fragment
        android:id="@+id/nav_event_details"
        android:name="com.example.ecossistemamobileweektech.EventDetailsFragment"
        android:label="Detalhes da Atividade"
        tools:layout="@layout/fragment_event_details">
        <argument
            android:name="activityName"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/nav_add_admin"
        android:name="com.example.ecossistemamobileweektech.AddAdminFragment"
        android:label="Adicionar Administrador"
        tools:layout="@layout/fragment_add_admin" />

    <fragment
        android:id="@+id/nav_map"
        android:name="com.example.ecossistemamobileweektech.MapFragment"
        android:label="Localização"
        tools:layout="@layout/fragment_map" />

    <fragment
        android:id="@+id/nav_faq"
        android:name="com.example.ecossistemamobileweektech.FaqFragment"
        android:label="FAQ"
        tools:layout="@layout/fragment_faq" />

</navigation>