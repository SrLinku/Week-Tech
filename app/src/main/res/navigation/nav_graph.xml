<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_auth_selection">

    <fragment
        android:id="@+id/nav_auth_selection"
        android:name="com.example.ecossistemamobileweektech.AuthSelectionFragment"
        android:label="Bem-vindo"
        tools:layout="@layout/fragment_auth_selection">
        <action
            android:id="@+id/action_auth_selection_to_home"
            app:destination="@id/nav_project_registration"
            app:popUpTo="@id/nav_auth_selection"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_auth_selection_to_admin_dashboard"
            app:destination="@id/nav_admin_dashboard"
            app:popUpTo="@id/nav_auth_selection"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_signup"
        android:name="com.example.ecossistemamobileweektech.SignupFragment"
        android:label="Criar Conta"
        tools:layout="@layout/fragment_signup" />

    <fragment
        android:id="@+id/nav_user_selection"
        android:name="com.example.ecossistemamobileweektech.UserSelectionFragment"
        android:label="Seleção de Acesso"
        tools:layout="@layout/fragment_user_selection">
        <action
            android:id="@+id/action_user_selection_to_student_login"
            app:destination="@id/nav_student_login" />
        <action
            android:id="@+id/action_user_selection_to_admin_login"
            app:destination="@id/nav_admin_login" />
    </fragment>

    <fragment
        android:id="@+id/nav_student_login"
        android:name="com.example.ecossistemamobileweektech.StudentLoginFragment"
        android:label="Login Estudante"
        tools:layout="@layout/fragment_student_login">
        <action
            android:id="@+id/action_student_login_to_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/nav_auth_selection"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.ecossistemamobileweektech.HomeFragment"
        android:label="Eventos Disponíveis"
        tools:layout="@layout/fragment_home" />




    <fragment
        android:id="@+id/nav_project_registration"
        android:name="com.example.ecossistemamobileweektech.ProjectRegistrationFragment"
        android:label="Cadastro Projeto"
        tools:layout="@layout/fragment_project_registration" />

    <fragment
        android:id="@+id/nav_admin_login"
        android:name="com.example.ecossistemamobileweektech.AdminLoginFragment"
        android:label="Login Admin"
        tools:layout="@layout/fragment_admin_login">
        <action
            android:id="@+id/action_login_to_dashboard"
            app:destination="@id/nav_admin_dashboard"
            app:popUpTo="@id/nav_auth_selection"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_admin_dashboard"
        android:name="com.example.ecossistemamobileweektech.AdminDashboardFragment"
        android:label="Painel Administrativo"
        tools:layout="@layout/fragment_admin_dashboard">
        <action
            android:id="@+id/action_dashboard_to_admin_management"
            app:destination="@id/nav_admin_management" />
    </fragment>

    <fragment
        android:id="@+id/nav_admin_management"
        android:name="com.example.ecossistemamobileweektech.AdminManagementFragment"
        android:label="Gerenciar Administradores"
        tools:layout="@layout/fragment_admin_management" />





    <fragment
        android:id="@+id/nav_my_inscriptions"
        android:name="com.example.ecossistemamobileweektech.MyInscriptionsFragment"
        android:label="Minhas Inscrições"
        tools:layout="@layout/fragment_my_inscriptions" />

</navigation>